+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "../../SDL_internal.h"
+
+#if defined(SDL_VIDEO_DRIVER_UIKIT) && defined(SDL_VIDEO_OPENGL_EGL)
+
+/* Desktop OpenGL on UIKit through a statically linked EGL implementation (SDL_UIKIT_EGL),
+ * e.g. Mesa's zink driver on MoltenVK. Rendering goes into a pbuffer of the EGL surfaceless
+ * platform; SwapWindow reads the frame back and presents it through the CAMetalLayer of an
+ * SDL Metal view, which also becomes the window's (input handling) view.
+ *
+ * ponytail: one readback + copy per frame. Zero-copy would need the EGL implementation to
+ * render into the Metal drawable (e.g. VK_EXT_metal_objects in zink). */
+
+#include "SDL_uikitegl.h"
+#include "SDL_uikitmetalview.h"
+#include "SDL_uikitwindow.h"
+#include "../SDL_egl_c.h"
+#include "SDL_opengl.h"
+
+#ifndef EGL_PLATFORM_SURFACELESS_MESA
+#define EGL_PLATFORM_SURFACELESS_MESA 0x31DD
+#endif
+#ifndef GL_PACK_INVERT_MESA
+#define GL_PACK_INVERT_MESA 0x8758
+#endif
+
+static PFNGLBINDBUFFERPROC UIKit_EGL_glBindBuffer;
+static PFNGLBINDFRAMEBUFFERPROC UIKit_EGL_glBindFramebuffer;
+static SDL_bool UIKit_EGL_hasPackInvert;
+
+/* EGL surface and Metal presentation of one window. */
+@interface SDL_uikiteglwindow : NSObject
+@property (nonatomic) EGLSurface surface;
+@property (nonatomic) int width;
+@property (nonatomic) int height;
+@property (nonatomic) SDL_MetalView view;
+@property (nonatomic, strong) CAMetalLayer *layer;
+@property (nonatomic, strong) id<MTLCommandQueue> queue;
+@property (nonatomic, strong) id<MTLBuffer> pixels;
+@property (nonatomic, strong) id<MTLCommandBuffer> lastFrame;
+@end
+
+@implementation SDL_uikiteglwindow
+
+- (void)dealloc
+{
+    SDL_VideoDevice *_this = SDL_GetVideoDevice();
+
+    [self.lastFrame waitUntilCompleted];
+    if (_this && _this->egl_data && self.surface != EGL_NO_SURFACE) {
+        SDL_EGL_DestroySurface(_this, self.surface);
+    }
+    if (_this && self.view) {
+        UIKit_Metal_DestroyView(_this, self.view);
+    }
+}
+
+@end
+
+/* (Re)creates the pbuffer and the readback buffer with the given size. */
+static int UIKit_EGL_SetSize(_THIS, SDL_uikiteglwindow *egl, int w, int h)
+{
+    EGLSurface surface, old = egl.surface;
+    id<MTLBuffer> pixels;
+
+    w = SDL_max(w, 1);
+    h = SDL_max(h, 1);
+    surface = SDL_EGL_CreateOffscreenSurface(_this, w, h);
+    if (surface == EGL_NO_SURFACE) {
+        return -1;
+    }
+    pixels = [egl.layer.device newBufferWithLength:(NSUInteger)w * h * 4 options:MTLResourceStorageModeShared];
+    if (!pixels) {
+        SDL_EGL_DestroySurface(_this, surface);
+        return SDL_OutOfMemory();
+    }
+
+    egl.surface = surface;
+    egl.width = w;
+    egl.height = h;
+    egl.pixels = pixels;
+
+    if (old != EGL_NO_SURFACE) {
+        /* keep rendering with the current context, now into the new surface */
+        if (SDL_GL_GetCurrentContext() && SDL_EGL_MakeCurrent(_this, surface, SDL_GL_GetCurrentContext()) < 0) {
+            return -1;
+        }
+        SDL_EGL_DestroySurface(_this, old);
+    }
+    return 0;
+}
+
+/* Reads the default framebuffer (the pbuffer) top-down into egl.pixels, leaving GL state untouched. */
+static void UIKit_EGL_ReadPixels(SDL_uikiteglwindow *egl)
+{
+    GLint pack_buffer = 0, read_framebuffer = 0, read_buffer = 0, invert = 0;
+    GLint alignment = 4, row_length = 0, skip_rows = 0, skip_pixels = 0;
+
+    if (UIKit_EGL_glBindBuffer) {
+        glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buffer);
+        UIKit_EGL_glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    }
+    if (UIKit_EGL_glBindFramebuffer) {
+        glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_framebuffer);
+        UIKit_EGL_glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    }
+    glGetIntegerv(GL_READ_BUFFER, &read_buffer);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+    glGetIntegerv(GL_PACK_ROW_LENGTH, &row_length);
+    glGetIntegerv(GL_PACK_SKIP_ROWS, &skip_rows);
+    glGetIntegerv(GL_PACK_SKIP_PIXELS, &skip_pixels);
+    if (UIKit_EGL_hasPackInvert) {
+        glGetIntegerv(GL_PACK_INVERT_MESA, &invert);
+        glPixelStorei(GL_PACK_INVERT_MESA, GL_TRUE); /* GL rows are bottom-up, Metal textures top-down */
+    }
+    glReadBuffer(GL_BACK);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_PACK_SKIP_ROWS, 0);
+    glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+
+    glReadPixels(0, 0, egl.width, egl.height, GL_BGRA, GL_UNSIGNED_BYTE, egl.pixels.contents);
+
+    glPixelStorei(GL_PACK_SKIP_PIXELS, skip_pixels);
+    glPixelStorei(GL_PACK_SKIP_ROWS, skip_rows);
+    glPixelStorei(GL_PACK_ROW_LENGTH, row_length);
+    glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+    glReadBuffer(read_buffer);
+    if (UIKit_EGL_hasPackInvert) {
+        glPixelStorei(GL_PACK_INVERT_MESA, invert);
+    }
+    if (UIKit_EGL_glBindFramebuffer) {
+        UIKit_EGL_glBindFramebuffer(GL_READ_FRAMEBUFFER, read_framebuffer);
+    }
+    if (UIKit_EGL_glBindBuffer) {
+        UIKit_EGL_glBindBuffer(GL_PIXEL_PACK_BUFFER, pack_buffer);
+    }
+}
+
+int UIKit_EGL_LoadLibrary(_THIS, const char *path)
+{
+    if (SDL_EGL_LoadLibrary(_this, path, EGL_DEFAULT_DISPLAY, EGL_PLATFORM_SURFACELESS_MESA) < 0) {
+        return -1;
+    }
+    /* windows render into pbuffers */
+    _this->egl_data->is_offscreen = SDL_TRUE;
+    return 0;
+}
+
+SDL_GLContext UIKit_EGL_CreateContext(_THIS, SDL_Window *window)
+{
+    @autoreleasepool {
+        SDL_WindowData *data = (__bridge SDL_WindowData *)window->driverdata;
+        SDL_uikiteglwindow *egl = data.egl;
+        SDL_GLContext context;
+
+        if (!egl) {
+            CGSize size;
+
+            if (SDL_EGL_ChooseConfig(_this) < 0) {
+                return NULL;
+            }
+            egl = [[SDL_uikiteglwindow alloc] init];
+            egl.view = UIKit_Metal_CreateView(_this, window);
+            if (!egl.view) {
+                return NULL;
+            }
+            egl.layer = (__bridge CAMetalLayer *)UIKit_Metal_GetLayer(_this, egl.view);
+            egl.layer.device = MTLCreateSystemDefaultDevice();
+            egl.layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
+            egl.layer.framebufferOnly = NO; /* frames are copied into the drawable */
+            egl.layer.opaque = YES;
+            egl.queue = [egl.layer.device newCommandQueue];
+            if (!egl.queue) {
+                SDL_SetError("Metal is not available");
+                return NULL;
+            }
+            size = egl.layer.drawableSize;
+            if (UIKit_EGL_SetSize(_this, egl, (int)size.width, (int)size.height) < 0) {
+                return NULL;
+            }
+            data.egl = egl;
+        }
+
+        context = SDL_EGL_CreateContext(_this, egl.surface);
+        if (context) {
+            UIKit_EGL_glBindBuffer = SDL_GL_GetProcAddress("glBindBuffer");
+            UIKit_EGL_glBindFramebuffer = SDL_GL_GetProcAddress("glBindFramebuffer");
+            UIKit_EGL_hasPackInvert = SDL_GL_ExtensionSupported("GL_MESA_pack_invert");
+        }
+        return context;
+    }
+}
+
+int UIKit_EGL_MakeCurrent(_THIS, SDL_Window *window, SDL_GLContext context)
+{
+    EGLSurface surface = EGL_NO_SURFACE;
+
+    if (window && context) {
+        SDL_WindowData *data = (__bridge SDL_WindowData *)window->driverdata;
+        if (data.egl) {
+            surface = data.egl.surface;
+        }
+    }
+    return SDL_EGL_MakeCurrent(_this, surface, context);
+}
+
+int UIKit_EGL_SetSwapInterval(_THIS, int interval)
+{
+    /* CAMetalLayer always presents in sync with the display.
+     * ponytail: interval 0 is accepted but stays synchronized. */
+    if (interval < 0) {
+        return SDL_Unsupported();
+    }
+    _this->egl_data->egl_swapinterval = interval;
+    return 0;
+}
+
+int UIKit_EGL_GetSwapInterval(_THIS)
+{
+    return _this->egl_data ? _this->egl_data->egl_swapinterval : 0;
+}
+
+int UIKit_EGL_SwapWindow(_THIS, SDL_Window *window)
+{
+    @autoreleasepool {
+        SDL_WindowData *data = (__bridge SDL_WindowData *)window->driverdata;
+        SDL_uikiteglwindow *egl = data.egl;
+        id<CAMetalDrawable> drawable;
+        CGSize size;
+
+        if (!egl) {
+            return SDL_SetError("No OpenGL context for this window");
+        }
+
+        /* the previous copy has to be done before its source gets overwritten */
+        [egl.lastFrame waitUntilCompleted];
+        UIKit_EGL_ReadPixels(egl);
+
+        drawable = [egl.layer nextDrawable];
+        if (drawable) {
+            id<MTLCommandBuffer> frame = [egl.queue commandBuffer];
+            id<MTLBlitCommandEncoder> blit = [frame blitCommandEncoder];
+            const NSUInteger w = SDL_min((NSUInteger)egl.width, drawable.texture.width);
+            const NSUInteger h = SDL_min((NSUInteger)egl.height, drawable.texture.height);
+
+            [blit copyFromBuffer:egl.pixels
+                       sourceOffset:0
+                  sourceBytesPerRow:(NSUInteger)egl.width * 4
+                sourceBytesPerImage:(NSUInteger)egl.width * egl.height * 4
+                         sourceSize:MTLSizeMake(w, h, 1)
+                          toTexture:drawable.texture
+                   destinationSlice:0
+                   destinationLevel:0
+                  destinationOrigin:MTLOriginMake(0, 0, 0)];
+            [blit endEncoding];
+            [frame presentDrawable:drawable];
+            [frame commit];
+            egl.lastFrame = frame;
+        }
+
+        /* follow size changes of the view (rotation, resizable windows) from the next frame on */
+        size = egl.layer.drawableSize;
+        if ((int)size.width != egl.width || (int)size.height != egl.height) {
+            return UIKit_EGL_SetSize(_this, egl, (int)size.width, (int)size.height);
+        }
+    }
+    return 0;
+}
+
+#endif /* SDL_VIDEO_DRIVER_UIKIT && SDL_VIDEO_OPENGL_EGL */
+
+/* vi: set ts=4 sw=4 expandtab: */
