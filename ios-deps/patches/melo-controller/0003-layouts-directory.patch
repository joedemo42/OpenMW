 public class LayoutExporter {
     public static var fileType = "meloLayout"
+
+    /// Where the layouts are saved (the app sets it before the controller view appears); nil: Documents/controller_layouts
+    public static var directory: URL?
     
     public static var meloLayout = UTType(exportedAs: "com.stossy11.melocontroller.layout",
                                    conformingTo: .data)
@@ -38,6 +41,9 @@
     private init() {}
 
