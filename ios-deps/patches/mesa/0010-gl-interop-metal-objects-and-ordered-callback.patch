+void
+MesaGLInteropRunAfterFlush(void (*fn)(void *data), void *data)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   struct pipe_context *pipe = ctx->st->pipe;
+
+   _mesa_glthread_finish(ctx);
+   st_flush(ctx->st, NULL, PIPE_FLUSH_ASYNC);
+   /* the threaded context runs the callback on its driver thread after the flush above, whose submit returned
+    * by then; without it the flush was synchronous
+    */
+   if (pipe->callback)
+      pipe->callback(pipe, fn, data, false);
+   else
+      fn(data);
 }
