+#ifdef VK_EXT_metal_objects
+/* GL interop on Metal: the Metal objects behind a texture (struct mesa_glinterop_metal_objects), for Metal work on
+ * the queue zink submits to; there is no dmabuf to export
+ */
+static uint32_t
+zink_interop_export_object(struct pipe_screen *pscreen, struct pipe_resource *pres, uint32_t in_data_size,
+                           void *data, bool *need_export_dmabuf)
+{
+   struct zink_screen *screen = zink_screen(pscreen);
+   struct mesa_glinterop_metal_objects *out = data;
+
+   *need_export_dmabuf = false;
+   if (in_data_size < sizeof(*out) || pres->target == PIPE_BUFFER)
+      return 0;
+
+   VkExportMetalTextureInfoEXT texture = {
+      .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_TEXTURE_INFO_EXT,
+      .image = zink_resource(pres)->obj->image,
+      .plane = VK_IMAGE_ASPECT_PLANE_0_BIT,
+   };
+   VkExportMetalCommandQueueInfoEXT queue = {
+      .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_COMMAND_QUEUE_INFO_EXT,
+      .pNext = &texture,
+      .queue = screen->queue,
+   };
+   VkExportMetalDeviceInfoEXT device = {
+      .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_DEVICE_INFO_EXT,
+      .pNext = &queue,
+   };
+   VkExportMetalObjectsInfoEXT info = {
+      .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT,
+      .pNext = &device,
+   };
+   VKSCR(ExportMetalObjectsEXT)(screen->dev, &info);
+
+   out->version = 1;
+   out->mtl_device = (void *)device.mtlDevice;
+   out->mtl_command_queue = (void *)queue.mtlCommandQueue;
+   out->mtl_texture = (void *)texture.mtlTexture;
+   return sizeof(*out);
+}
+#endif
+
